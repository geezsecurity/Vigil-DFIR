# dependencies
node_modules/

# case data — NEVER commit (rules, cases, catalog/index databases, raw logs — may contain
# real incident / PII data). Matches ./data, ./server/data, and dev variants like data-dev/.
**/data/
**/data-*/
!**/data/.gitkeep
*.evtx
*.jsonl
*.db
*.db-shm
*.db-wal
*.yml

# archives / backups
*.zip

# logs & scratch
*.log
scratchpad/
tmp/
.DS_Store
.claude
